# Base URL for frontend API requests (defaults to /api if served via same-origin reverse proxy)
VITE_API_BASE_URL=/api

# Canonical public website domain used during build-time prerendering and sitemap generation.
# If omitted, defaults to https://iconelectromatic.com
# Example: VITE_SITE_ORIGIN=https://iconelectromatic.com
VITE_SITE_ORIGIN=https://iconelectromatic.com
SITE_ORIGIN=https://iconelectromatic.com
