# Copy this template to the client-managed Nginx configuration and replace every
# placeholder before enabling it. This is an example, not a production-ready
# configuration until DNS, TLS, paths, upstream access, and proxy trust are reviewed.

upstream icon_backend {
    # Private address reachable only from this Nginx host/network.
    server BACKEND_PRIVATE_HOST:BACKEND_PORT;
    keepalive 16;
}

server {
    listen 80;
    server_name YOUR_DOMAIN;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name YOUR_DOMAIN;

    # Absolute path to the built frontend dist/ directory.
    root /ABSOLUTE/PATH/TO/REPOSITORY/dist;
    index index.html;

    # Install certificates using the client's approved certificate process.
    ssl_certificate /PATH/TO/TLS/FULLCHAIN.pem;
    ssl_certificate_key /PATH/TO/TLS/PRIVATE_KEY.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Optional: enable HSTS only after HTTPS is fully operational and the client
    # approves its policy. Add includeSubDomains only if every subdomain is HTTPS-ready.
    # add_header Strict-Transport-Security "max-age=31536000" always;

    # Public sitemap is generated by the backend from the database, with the
    # backend's configured SITE_ORIGIN defining canonical URLs.
    location = /sitemap.xml {
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://icon_backend/api/sitemap.xml;
    }

    # Keep /api in the upstream request path. The backend mounts routes at /api.
    location /api/ {
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://icon_backend;
    }

    # Serve existing prerendered product/core-page files before falling back to
    # the SPA entry point for client-side routes.
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# Client must replace:
# - YOUR_DOMAIN with the client-approved canonical host.
# - BACKEND_PRIVATE_HOST and BACKEND_PORT with the private backend endpoint.
# - /ABSOLUTE/PATH/TO/REPOSITORY/dist with the deployed frontend build path.
# - TLS certificate paths with provisioned, renewable client certificates.
#
# Security/operator notes:
# - Do not expose the backend listener directly to the public internet; permit
#   inbound API traffic only from this proxy/private network where possible.
# - Configure TRUST_PROXY for the actual trusted proxy chain. TRUST_PROXY=1 is
#   appropriate only when this Nginx instance is the single trusted hop and the
#   backend cannot be reached around it.
# - If a CDN/load balancer is in front, do not trust arbitrary forwarded headers.
#   Configure real-client-IP handling using the provider's current trusted ranges
#   and have the edge remove or overwrite client-supplied forwarding headers.
# - Review upload size/time limits with the application and hosting policy before
#   changing Nginx defaults; do not silently make them broader.
# - Use a certificate renewal process and test HTTP-to-HTTPS redirects, static
#   prerender routes, /api/health, and /sitemap.xml before directing DNS traffic.
