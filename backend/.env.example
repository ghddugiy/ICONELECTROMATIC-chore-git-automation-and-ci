# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# Comma-separated list of allowed frontend origins for CORS credentials.
# In development: defaults to localhost:3000, localhost:5173 if empty.
# In production: ONLY explicitly configured origins in FRONTEND_URL are allowed.
# Example: FRONTEND_URL=https://iconelectromatic.com,https://www.iconelectromatic.com
FRONTEND_URL=http://localhost:5173

# Set to "production" in production:
# - Enforces __Host- cookie prefixes and Secure cookie flags
# - Restricts CORS allowlists strictly to FRONTEND_URL
# - Strips development fallback origins
NODE_ENV=development

# Reverse proxy trust setting for client IP resolution and rate limiting.
# Options:
#   - Leave blank or "false" (default): direct connection, no upstream proxy.
#   - "1": Single reverse proxy hop (e.g. Vercel, Railway, Render, Cloudflare, AWS ALB).
#   - "loopback" or CIDR subnet (e.g. "loopback, 10.0.0.0/8"): trust specific proxy addresses.
# CAUTION: Never set to "true" unless behind an upstream proxy that sanitizes X-Forwarded-For.
TRUST_PROXY=

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME?schema=public

# ── Email delivery (Resend) ───────────────────────────────────────────────────
# Sign up at https://resend.com — free tier: 3,000 emails/month.
# Steps:
#   1. Create an account at https://resend.com
#   2. Go to API Keys → Create API Key → copy the key below.
#   3. Go to Domains → Add Domain → verify iconelectromatic.com with your DNS registrar.
#      Until the domain is verified you can use the Resend test address as ENQUIRY_FROM.
#   4. Set CONTACT_EMAIL to the inbox that should receive all enquiries (confirm with client).
RESEND_API_KEY=re_YOUR_API_KEY_HERE

# The "From" address. Must match a verified Resend domain in production.
# During testing you may use: onboarding@resend.dev (Resend's shared test sender).
ENQUIRY_FROM=onboarding@resend.dev

# Single inbox for all enquiries (contact, RFQ, and careers).
# Confirm the final address with the client before going live.
CONTACT_EMAIL=sales@iconelectromatic.com

# ── Cloudflare R2 image storage ───────────────────────────────────────────────
R2_ACCOUNT_ID=YOUR_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
R2_BUCKET_NAME=YOUR_BUCKET_NAME
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# Optional: set this to your Cloudflare R2 public bucket domain so images are
# served via CDN rather than through presigned URLs (which expire after 15 min).
# Example: https://pub-abc123.r2.dev
R2_PUBLIC_DOMAIN=
