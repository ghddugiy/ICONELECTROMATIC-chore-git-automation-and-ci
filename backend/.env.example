# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# Comma-separated list of allowed frontend origins for CORS credentials.
# In development: defaults to localhost:3000, localhost:5173 if empty.
# In production: ONLY explicitly configured origins in FRONTEND_URL are allowed.
# Example: FRONTEND_URL=https://iconelectromatic.com,https://www.iconelectromatic.com
FRONTEND_URL=http://localhost:5173

# Set to "production" in production:
# - Enforces __Host- cookie prefixes and Secure cookie flags
# - Restricts CORS allowlists strictly to FRONTEND_URL
# - Strips development fallback origins
NODE_ENV=development

# Reverse proxy trust setting for client IP resolution and rate limiting.
# Options:
#   - Leave blank or "false" (default): direct connection, no upstream proxy.
#   - "1": Single reverse proxy hop (e.g. Vercel, Railway, Render, Cloudflare, AWS ALB).
#   - "loopback" or CIDR subnet (e.g. "loopback, 10.0.0.0/8"): trust specific proxy addresses.
# CAUTION: Never set to "true" unless behind an upstream proxy that sanitizes X-Forwarded-For.
TRUST_PROXY=

# Canonical public website domain used for dynamic sitemap generation (/sitemap.xml).
# If omitted, defaults to https://iconelectromatic.com
# Example: SITE_ORIGIN=https://iconelectromatic.com
SITE_ORIGIN=https://iconelectromatic.com

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME?schema=public

# Local backend tests use only the Docker test database on port 5433.
# Leave unset in shared environments; configure it in the local test shell.
TEST_DATABASE_URL=

# ── Email delivery (Resend) ───────────────────────────────────────────────────
# Sign up at https://resend.com — free tier: 3,000 emails/month.
# Production setup steps:
#   1. Create an account at https://resend.com
#   2. Go to API Keys → Create API Key with "Sending access"
#   3. Go to Domains → Add Domain → verify your company domain with DNS records
#   4. Set the three environment variables below:
#      - RESEND_API_KEY: Resend API key starting with re_
#      - RESEND_FROM_EMAIL: Sender address on your verified domain (e.g. notifications@iconelectromatic.com)
#      - CONTACT_EMAIL: Recipient inbox for enquiries and applications (e.g. sales@iconelectromatic.com)
# Note: ENQUIRY_FROM is supported as a temporary backward-compatible fallback for RESEND_FROM_EMAIL.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_EMAIL=

# ── Cloudflare R2 image storage ───────────────────────────────────────────────
R2_ACCOUNT_ID=YOUR_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
R2_BUCKET_NAME=YOUR_BUCKET_NAME
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# Optional: set this to your Cloudflare R2 public bucket domain so images are
# served via CDN rather than through presigned URLs (which expire after 15 min).
# Example: https://pub-abc123.r2.dev
R2_PUBLIC_DOMAIN=

# One-time operations only. Set through a secret manager, then remove after use.
# ADMIN_EMAIL and ADMIN_PASSWORD are used by provision-admin.js --non-interactive.
# PRODUCTION_DATABASE_URL is used only by the guarded production catalogue seeder.
# Never pass passwords in command-line arguments or commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
PRODUCTION_DATABASE_URL=
